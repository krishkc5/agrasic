# Shell scripts and firmware build inputs MUST stay LF. CRLF line endings break
# the shebang and silently skip steps when these are run under WSL/Linux.
*.sh   text eol=lf
*.ld   text eol=lf
*.S    text eol=lf
*.py   text eol=lf
# The ROM image is regenerated by fw/build.sh under WSL, so it is written LF.
# Without this it round-trips through CRLF on checkout and every rebuild shows
# a phantom diff.
*.hex  text eol=lf

# RTL and docs: normalize to LF in the repo.
*.sv   text eol=lf
*.v    text eol=lf
*.c    text eol=lf
*.md   text eol=lf
# Diagrams are compared against regenerated output; without this every SVG shows
# a whole-file diff on Windows that is nothing but line endings.
*.svg  text eol=lf

# Binary assets
*.pdf  binary
*.jpeg binary
